# Шаблон аккаунта. Чтобы добавить аккаунт:
# 1. Скопировать папку account_example в accounts/ и переименовать, например: acc_74738286 Jonny Cash
# 2. Заполнить account.env (переименовать этот файл в account.env)
# 3. Для аккаунта-пользователя: python accounts/login.py "acc_74738286 Jonny Cash"
#    Для бота логин не нужен, достаточно TG_BOT_TOKEN.
#
# TG_KIND: user (обычный аккаунт) или bot
# TG_API_ID и TG_API_HASH: https://my.telegram.org -> API development tools

TG_KIND=user
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_BOT_TOKEN=
